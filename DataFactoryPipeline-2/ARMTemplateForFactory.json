												]
											}
										]
									}
								}
							]
						}
					},
					{
						"name": "Trigger_on_Arrival",
						"type": "Validation",
						"dependsOn": [],
						"userProperties": [],
						"typeProperties": {
							"dataset": {
								"referenceName": "ds_csv_file_based",
								"type": "DatasetReference",
								"parameters": {

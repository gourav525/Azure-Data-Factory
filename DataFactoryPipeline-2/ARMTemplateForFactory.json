																"type": "DatasetReference",
																"parameters": {
																	"p_container": "adf-pipeline-2",
																	"p_folder": "files",
																	"p_file": {
																		"value": "@item().name",
																		"type": "Expression"
																	}
																}
															}
														],
														"outputs": [
															{
																"referenceName": "ds_csv_file_based",
																"type": "DatasetReference",
																"parameters": {
																	"p_container": "adf-pipeline2-sink",
																	"p_folder": "Drivers",
																	"p_file": {
